class Solution {
public:
    int s;
    int largestInteger(int n, int s) {
        this->s=s;
        int ld = 10;
        while(n!=1){
            ld*= 10;
            n--;
        }
        int ans=-1e9;
        for(int i=0;i<ld;i++){
            if(check(i)){
                ans=max(ans,i);
            }
        }
        return ans==-1e9? -1: ans;
    }
    bool check(int i){
        int sum=0;
        while(i!=0){
            int d = i%10;
            i= i/10;
            sum+= d;
        }
        return sum==s;
    }
};
