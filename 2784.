class Solution {
public:
    bool isGood(vector<int>& nums) {
        vector<int>ans;
        int j = 1;
        for(int i=0;i<nums.size()-1;i++){
             ans.push_back(j);
             j++;
        }
        if(nums.size()==1){
            return false;
        }
        int l = ans.back();
        ans.push_back(l);
        sort(nums.begin(),nums.end());
        return nums==ans;
    }
};
